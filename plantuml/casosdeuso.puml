@startuml
left to right direction
skinparam packageStyle rectangle

actor "Cliente\n(Estudiante/Profesor)" as Cliente
actor Barista
actor "Pasarela de Pago" as Pasarela <<Sistema Externo>>
actor "Sistema de Matrícula" as Matricula <<Sistema Externo>>

rectangle "Coffee Campus App" {
    usecase "Consultar Menú" as UC1
    usecase "Iniciar Sesión" as UC2
    usecase "Crear Pedido" as UC3
    usecase "Aplicar Descuento Estudiantil" as UC4
    usecase "Validar Matrícula" as UC5
    usecase "Procesar Pago" as UC6
    usecase "Preparar Pedido" as UC7
    usecase "Notificar Cliente" as UC8
}

Cliente --> UC1
Cliente --> UC3
Cliente --> UC6

UC3 ..> UC2 : <<include>>
UC4 .up.> UC3 : <<extend>>
UC4 ..> UC5 : <<include>>
UC5 --> Matricula

UC6 --> Pasarela
Barista --> UC7
UC7 ..> UC8 : <<include>>
@enduml