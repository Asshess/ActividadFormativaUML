@startuml
allowmixing
skinparam nodesep 70
skinparam ranksep 80
skinparam padding 5

actor Cliente
object "interfaz : AppUI" as UI
object "ctrlPedido : ControladorPedido" as CP
object "ctrlPago : ControladorPago" as CPago
object "p : Pedido" as Pedido
object "pasarela : Pasarela de Pago" as Pasarela

Cliente -> UI : 1: seleccionarProductos()\n5: confirmarYpagar()
UI -> CP : 2: iniciarPedido(lista)
CP -> Pedido : 3: crear(lista)
CP -> UI : 4: mostrarTotal(total)

UI -> CPago : 6: procesarPago(id)
CPago -> Pasarela : 7: autorizarTransaccion()
Pasarela -> CPago : 8: transaccionAprobada()
CPago -> Pedido : 9: actualizarEstado("Pagado")
CPago -> UI : 10: pagoExitoso()
UI -> Cliente : 11: mostrarRecibo(id)
@enduml